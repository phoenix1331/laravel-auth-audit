{
    "name": "phoenix1331/laravel-auth-audit",
    "description": "Authorisation coverage reporting for Laravel applications. Statically scans routes, controllers, Form Requests, and Policies to report what is and is not protected.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "security",
        "authorisation",
        "authorization",
        "audit",
        "idor",
        "idor-detection",
        "owasp",
        "access-control",
        "static-analysis",
        "baseline"
    ],
    "homepage": "https://github.com/phoenix1331/laravel-auth-audit",
    "authors": [
        {
            "name": "Darren Williams",
            "homepage": "https://github.com/phoenix1331"
        }
    ],
    "support": {
        "issues": "https://github.com/phoenix1331/laravel-auth-audit/issues",
        "source": "https://github.com/phoenix1331/laravel-auth-audit"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Phoenix1331\\LaravelAuthAudit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phoenix1331\\LaravelAuthAudit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phoenix1331\\LaravelAuthAudit\\LaravelAuthAuditServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
